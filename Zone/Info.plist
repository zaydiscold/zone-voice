<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ZoneBuildAction</key>
	<string>$(ACTION)</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Zone</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>zone</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Zone uses the camera only to scan the pairing code your computer shows when you pair it in Settings, Computers.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>After you pair a computer in Settings, Zone can send your dictations, notes and meeting transcripts to it directly when both are on the same network.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Zone uses the mic for dictation, voice notes and meetings. Standby keeps it ready for the keyboard.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Lets the Zone keyboard use Apple’s on-device speech recognition if Zone’s speech model cannot recognize your dictation.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>wtf.zayd.zone.quick.note</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Voice note</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Saved in Zone</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>note.text</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>wtf.zayd.zone.quick.dictate</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Dictate and copy</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Paste it anywhere</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>doc.on.clipboard</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>wtf.zayd.zone.quick.meeting</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Record a meeting</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Transcribed on this iPhone</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>person.2.wave.2</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>wtf.zayd.zone.quick.share</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Share Zone with a friend</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>App Store link</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>heart</string>
		</dict>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>processing</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>microphone</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>ZoneAppGroup</key>
	<string>$(ZONE_APP_GROUP)</string>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>wtf.zayd.zone.backup</string>
			<key>UTTypeDescription</key>
			<string>Zone Library Backup</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>zonebackup</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Zone Library Backup</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>wtf.zayd.zone.backup</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).meeting-transcript.*</string>
	</array>
</dict>
</plist>
